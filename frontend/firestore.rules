rules_version = '2';

// Serverless backend for the GFA typing app.
// All access requires a signed-in user whose email is on the felice.ed.jp domain.
service cloud.firestore {
  match /databases/{database}/documents {

    function isDomainUser() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.matches('.*@felice[.]ed[.]jp$');
    }

    function isOwner(uid) {
      return isDomainUser() && request.auth.uid == uid;
    }

    // The classroom admin may manage other users' class assignments.
    function isAdminUser() {
      return isDomainUser()
        && request.auth.token.email == 'john.limpiada@felice.ed.jp';
    }

    // Fields on users/{uid} that grant coins/xp, own an item, or feed a
    // leaderboard/rank. These are only ever written by the Vercel API
    // endpoints (via the Admin SDK, which bypasses these rules entirely) or
    // by the admin - never directly by a student's own client, since that
    // client is untrusted (anyone can open devtools and call the Firebase
    // SDK directly with whatever value they want). See api/_lib and
    // api/buy-item.ts, api/complete-lesson.ts, api/submit-result.ts,
    // api/claim-reward.ts for the validated write paths.
    function economyFields() {
      return [
        'coins', 'xp', 'personalBests', 'streak', 'weeklyPeriod',
        'timeTyping', 'startedTests', 'completedTests',
        'ownedBackdrops', 'ownedPets', 'ownedRgbPalettes', 'ownedCostumes',
        'ownedHouseItems', 'ownedHandStyles', 'ownedCaretEffects',
        'ownedKeyboardSkins', 'ownedKeypressEffects', 'ownedSideImageSets',
        'ownedAnimalAvatars',
        'houseGreetingDate',
        'questsWeekId', 'questProgress', 'questsClaimed', 'questDedupe',
        'raceBestWpm', 'raceBestWpmAcc', 'raceBestAcc', 'raceBestAccWpm',
        'raceTotalRaces', 'raceWins'
      ];
    }

    // --- users/{uid} and all user-scoped subcollections ---
    match /users/{uid} {
      allow read: if isDomainUser();
      // create: one-time account bootstrap (ape/firestore/users.ts) writes
      // every field at its default/zero value - not an exploit surface.
      allow create: if isOwner(uid) || isAdminUser();
      // update: students keep direct write access to cosmetic/preference
      // fields (equipped items, selected palettes, layout, ...); economy
      // fields are blocked here and must go through a validated endpoint.
      allow update: if isAdminUser()
        || (isOwner(uid)
          && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(economyFields()));
      allow delete: if isOwner(uid);

      // config + tags: owner full access
      match /config/{docId} {
        allow read, write: if isOwner(uid);
      }

      // typing lesson progress: written only by api/complete-lesson.ts
      // (Admin SDK); admin may read for the teacher dashboard.
      match /lessonProgress/{lessonId} {
        allow read: if isOwner(uid) || isAdminUser();
        allow write: if isAdminUser();
      }

      // achievements: owner full access; admin may read.
      match /achievements/{achievementId} {
        allow read: if isOwner(uid) || isAdminUser();
        allow write: if isOwner(uid);
      }

      // daily-capped "repeat practice" coin buckets: written only by
      // api/submit-result.ts (Admin SDK).
      match /testTryCoins/{bucketId} {
        allow read: if isOwner(uid) || isAdminUser();
        allow write: if isAdminUser();
      }
      match /tags/{tagId} {
        allow read, write: if isOwner(uid);
      }

      // results: created only by api/submit-result.ts (Admin SDK), since
      // wpm/acc/xp there feed personal bests and leaderboards. Owner may
      // still update (tag labelling only) and delete (account reset).
      match /results/{resultId} {
        allow read: if isOwner(uid) || isAdminUser();
        allow create: if false;
        allow update: if isOwner(uid);
        allow delete: if isOwner(uid);
      }
    }

    // --- teacher-authored class word lists ---
    match /wordLists/{id} {
      allow read: if isDomainUser();
      allow write: if isAdminUser();
    }

    // --- teacher-authored reading passages ---
    match /readingPassages/{id} {
      allow read: if isDomainUser();
      allow write: if isAdminUser();
    }

    // --- teacher-authored assignments ---
    match /assignments/{id} {
      allow read: if isDomainUser();
      allow write: if isAdminUser();
    }

    // --- teacher announcements ---
    match /announcements/{id} {
      allow read: if isDomainUser();
      allow write: if isAdminUser();
    }

    // --- live class races ---
    // The teacher (admin) owns the race control doc; each student writes their
    // own participant doc with live progress. Admin may also write/delete any
    // participant doc, so a new round can be reset authoritatively even for
    // students who disconnected instead of resetting their own doc.
    match /races/{pin} {
      allow read: if isDomainUser();
      allow create, update, delete: if isAdminUser();
      match /participants/{uid} {
        allow read: if isDomainUser();
        allow create: if (isOwner(uid)
          && request.resource.data.uid == request.auth.uid)
          || isAdminUser();
        // Live progress ticks (wordIndex/progress/liveWpm/lastSeen) and
        // resetting back to zero stay student-writable; an actual final
        // result (finished/finishedAt/finalWpm/finalAcc going non-zero)
        // must go through api/submit-race-result.ts so it gets sanity
        // checked against the race's real content instead of trusted as-is.
        allow update: if isAdminUser()
          || (isOwner(uid)
            && request.resource.data.uid == request.auth.uid
            && (
              !request.resource.data.diff(resource.data).affectedKeys()
                  .hasAny(['finished', 'finishedAt', 'finalWpm', 'finalAcc'])
              || (request.resource.data.finished == false
                && request.resource.data.finalWpm == 0
                && request.resource.data.finalAcc == 0)
            ));
        allow delete: if isOwner(uid) || isAdminUser();
      }
    }

    // --- saved race history (teacher-readable review records) ---
    match /raceHistory/{id} {
      allow read: if isDomainUser();
      allow write: if isAdminUser();
    }

    // --- username uniqueness registry ---
    match /usernames/{name} {
      allow read: if isDomainUser();
      // a user may only claim a name for their own uid, and only if free
      allow create: if isDomainUser()
        && request.resource.data.uid == request.auth.uid;
      allow delete: if isDomainUser()
        && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // --- school-wide config (side images, etc.) ---
    match /schoolConfig/{document} {
      allow read: if isDomainUser();
      allow write: if isAdminUser();
    }

    // --- leaderboards: readable by domain users, written only by
    // api/submit-result.ts (Admin SDK) - a direct client write here used to
    // let any student self-report an arbitrary wpm straight onto the board.
    match /leaderboards/{key} {
      allow read: if isDomainUser();
      match /entries/{uid} {
        allow read: if isDomainUser();
        allow write: if false;
      }
    }

    // --- daily speed leaderboards ---
    match /dailyLeaderboards/{key} {
      allow read: if isDomainUser();
      match /entries/{uid} {
        allow read: if isDomainUser();
        allow write: if false;
      }
    }

    // --- weekly xp leaderboards ---
    match /weeklyXpLeaderboards/{week} {
      allow read: if isDomainUser();
      match /entries/{uid} {
        allow read: if isDomainUser();
        allow write: if false;
      }
    }

    // --- cached grade/school classroom leaderboard rankings ---
    // Only written by the /api/refresh-leaderboard-cache Vercel function via
    // the Firebase Admin SDK, which bypasses these rules entirely.
    match /leaderboardCache/{id} {
      allow read: if isDomainUser();
      allow write: if false;
    }
  }
}
