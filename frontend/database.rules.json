{
  "rules": {
    ".read": false,
    ".write": false,
    "config": {
      "searchSettings": {
        ".read": true,
        ".write": "auth != null && auth.token.email_verified == true && auth.token.email.matches(/.*@felice[.]ed[.]jp$/)"
      },
      "admins": {
        ".read": "auth != null && auth.token.email_verified == true && auth.token.email.matches(/.*@felice[.]ed[.]jp$/)",
        ".write": "auth != null && auth.token.email_verified == true && auth.token.email.matches(/.*@felice[.]ed[.]jp$/)"
      }
    },
    "searchCache": {
      ".read": true,
      ".write": true
    },
    "workerActivityLogs": {
      ".read": "auth != null && auth.token.email_verified == true && auth.token.email.matches(/.*@felice[.]ed[.]jp$/)",
      ".write": "auth != null && auth.token.email_verified == true && auth.token.email.matches(/.*@felice[.]ed[.]jp$/)"
    },
    "ghostRooms": {
      "$code": {
        ".read": "auth != null && auth.token.email != null && auth.token.email.matches(/.*@felice[.]ed[.]jp$/)",
        ".write": "auth != null && auth.token.email != null && auth.token.email.matches(/.*@felice[.]ed[.]jp$/) && ((!data.exists() && newData.child('hostUid').val() == auth.uid) || data.child('hostUid').val() == auth.uid)",
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid == $uid && ((!data.exists() && root.child('ghostRooms').child($code).child('status').val() == 'lobby') || (data.exists() && root.child('ghostRooms').child($code).child('status').val() != 'finished'))",
            ".validate": "!newData.exists() || (newData.child('uid').val() == $uid && (auth.uid == $uid || root.child('ghostRooms').child($code).child('hostUid').val() == auth.uid) && newData.child('name').isString() && newData.child('name').val().length <= 40 && newData.child('score').isNumber() && newData.child('score').val() >= 0 && newData.child('wave').isNumber() && newData.child('wave').val() >= 1 && newData.child('finished').isBoolean() && newData.child('online').isBoolean() && newData.child('position').isNumber() && newData.child('position').val() >= 0 && newData.child('position').val() <= 1 && (newData.child('facing').val() == 'left' || newData.child('facing').val() == 'right'))"
          }
        },
        "status": {
          ".validate": "newData.val() == 'lobby' || newData.val() == 'countdown' || newData.val() == 'playing' || newData.val() == 'finished'"
        },
        "maxWave": {
          ".validate": "(newData.val() == 5 || newData.val() == 10) && (!data.exists() || newData.val() == data.val())"
        },
        "difficultyLabel": {
          ".validate": "(newData.val() == 'Medium' || newData.val() == 'Hard') && (!data.exists() || newData.val() == data.val())"
        },
        "hostUid": {
          ".validate": "newData.isString() && newData.val() == auth.uid"
        },
        "words": {
          ".validate": "newData.hasChildren()",
          "$index": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60"
          }
        }
      }
    },
    "ghostWorlds": {
      "$code": {
        ".read": "auth != null && auth.token.email != null && auth.token.email.matches(/.*@felice[.]ed[.]jp$/) && root.child('ghostRooms').child($code).exists()",
        ".write": "auth != null && root.child('ghostRooms').child($code).child('hostUid').val() == auth.uid"
      }
    },
    "ghostActions": {
      "$code": {
        ".read": "auth != null && root.child('ghostRooms').child($code).child('hostUid').val() == auth.uid",
        ".write": "auth != null && root.child('ghostRooms').child($code).child('hostUid').val() == auth.uid",
        "$actionId": {
          ".write": "auth != null && root.child('ghostRooms').child($code).child('status').val() == 'playing' && !data.exists() && newData.child('uid').val() == auth.uid",
          ".validate": "newData.hasChildren(['uid', 'word', 'createdAt']) && newData.child('uid').isString() && newData.child('word').isString() && newData.child('word').val().length > 0 && newData.child('word').val().length <= 60 && newData.child('createdAt').isNumber()"
        }
      }
    }
  }
}
